# Copy to apps/web/.env.local and apps/worker/.env for local work.
# In staging and production these live only in Railway and Inngest settings.
# This repo is public: never commit real values.

# The app's public URL, used in sign-in links. On Railway it falls back to RAILWAY_PUBLIC_DOMAIN.
SITE_URL=http://localhost:3000

# Supabase (local defaults come from `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Inngest (set INNGEST_DEV=1 locally to use the dev server instead of keys)
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Worker
WORKER_MAX_CONCURRENCY=10

# Providers
ANTHROPIC_API_KEY=
APIFY_TOKEN=
REOON_API_KEY=
BOUNCEBAN_API_KEY=
FINDYMAIL_API_KEY=
ICYPEAS_API_KEY=

# Monitoring
SENTRY_DSN=
