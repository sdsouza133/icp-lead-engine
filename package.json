{
  "name": "icp-lead-engine",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p .railway",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.19.2",
    "railway": "^3.16.0",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
